GENESIS_ADMIN_PASSWORD=troque-por-uma-senha-forte
GENESIS_AUTH_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
GENESIS_AGENT_API_TOKEN=gere-um-token-separado-para-a-api-de-agentes
ENABLE_AGENT_API_TRADING=false
ALLOW_EXCHANGE_WRITE=false
GENESIS_AGENT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
