# Perfil operacional sem segredos. Preencha somente no ambiente de execução.
GENESIS_ENVIRONMENT=local
GENESIS_VERSION=unversioned
# Coleta inicial e periódica de CPU/memória por processo.
GENESIS_RESOURCE_MONITOR_ENABLED=true
GENESIS_RESOURCE_SAMPLE_INTERVAL_SECONDS=300
# Telemetria de duração dos ciclos e integrações externas.
GENESIS_PERFORMANCE_METRICS_DIR=runtime/metrics
# Contagem periódica dos estados de decisão persistidos.
GENESIS_DECISION_METRICS_ENABLED=true
GENESIS_DECISION_METRICS_INTERVAL_SECONDS=300
# Verificação read-only de conexões, locks e sessões bloqueadas do PostgreSQL.
GENESIS_POSTGRES_METRICS_ENABLED=true
GENESIS_POSTGRES_METRICS_INTERVAL_SECONDS=300
GENESIS_POSITION_RECONCILIATION_ENABLED=true
GENESIS_POSITION_RECONCILIATION_INTERVAL_SECONDS=300
GENESIS_POSITION_QTY_TOLERANCE=0.00000001
GENESIS_POSITION_PRICE_TOLERANCE=0.000001
GENESIS_PROCESS_AUDIT_ENABLED=true
GENESIS_PROCESS_AUDIT_INTERVAL_SECONDS=300
GENESIS_PROCESS_AUDIT_LOOKBACK_SECONDS=86400
# Alerta quando o worker não observa novo candle dentro do prazo.
GENESIS_CANDLE_STALE_SECONDS=600
GENESIS_CANDLE_ALERT_INTERVAL_SECONDS=60
GENESIS_DATABASE_BACKEND=postgres
GENESIS_DATABASE_URL=postgresql://user:password@host:5432/genesis_trading
ENABLE_AGENT_API_TRADING=false
ALLOW_EXCHANGE_WRITE=false
GENESIS_AGENT_API_TOKEN=configure-a-secret-token-outside-this-file
GENESIS_AGENT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ENABLE_LIVE_TRADING=false
ACTIVE_EXCHANGE=okx
# Decisões IN_PROGRESS sem atividade acima deste prazo são expiradas pelo watchdog.
GENESIS_DECISION_EXPIRATION_MINUTES=15
# Resiliência das integrações externas.
GENESIS_CB_FAILURE_THRESHOLD=3
GENESIS_CB_RESET_SECONDS=30
GENESIS_HTTP_MAX_RETRIES=2
GENESIS_HTTP_BACKOFF_BASE_SECONDS=0.5
GENESIS_HTTP_BACKOFF_MAX_SECONDS=8
# Com poucos dados, bloquear novas entradas por padrão.
MODEL_FALLBACK_POUCOS_DADOS_ACTION=block
MODEL_FALLBACK_RISK_MULTIPLIER=0.25
